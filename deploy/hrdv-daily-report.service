[Unit]
Description=HR_DV_worker — daily funnel report + transcripts to the control chat
After=network-online.target docker.service hrdv-postgres.service
Wants=network-online.target hrdv-postgres.service

[Service]
Type=oneshot
User=hrdv
Group=hrdv
WorkingDirectory=/opt/HR_DV_worker
ExecStart=/opt/HR_DV_worker/.venv/bin/python /opt/HR_DV_worker/scripts/daily_report.py
