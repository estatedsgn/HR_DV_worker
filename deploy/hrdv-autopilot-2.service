[Unit]
Description=HR_DV_worker — funnel autopilot for account #2 (Марго, own key, leads-only)
After=network-online.target docker.service hrdv-postgres.service hrdv-account-sync.service
Wants=network-online.target hrdv-postgres.service hrdv-account-sync.service
Requires=docker.service

[Service]
Type=simple
User=hrdv
Group=hrdv
WorkingDirectory=/opt/HR_DV_worker
ExecStart=/opt/HR_DV_worker/.venv/bin/python -u scripts/run_autopilot.py --account db850ae7-d8dc-4618-a038-8957dd9dd616 --leads-only --allow-real-send --poll-interval-seconds 3
Restart=always
RestartSec=10
StandardOutput=append:/opt/HR_DV_worker/runtime_logs/autopilot2.log
StandardError=append:/opt/HR_DV_worker/runtime_logs/autopilot2.log

[Install]
WantedBy=multi-user.target
