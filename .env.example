APP_ENV=local
DATABASE_URL=postgresql+asyncpg://hr_dv_worker:hr_dv_worker@localhost:5432/hr_dv_worker
LOG_LEVEL=INFO

CRMCHAT_API_BASE_URL=https://api.crmchat.ai
CRMCHAT_API_KEY=sk_change_me
CRMCHAT_WEBHOOK_SECRET=change-me
CRMCHAT_ORGANIZATION_ID=
CRMCHAT_WORKSPACE_ID=
CRMCHAT_DEFAULT_TELEGRAM_ACCOUNT_ID=
CRMCHAT_TIMEOUT_SECONDS=10
TELEGRAM_POLL_INTERVAL_SECONDS=60
TELEGRAM_POLL_DIALOGS_LIMIT=20
TELEGRAM_POLL_HISTORY_LIMIT=20
TELEGRAM_MARK_READ_AFTER_POLL=false
LLM_PROVIDER=openai
LLM_API_KEY=change-me
# Optional pool of interchangeable keys for the same provider (comma-separated).
# When the active key's quota is exhausted the runtime auto-rotates to the next.
# LLM_API_KEY above is appended last as a fallback.
LLM_API_KEYS=
LLM_KEY_STATE_PATH=runtime_logs/llm_key_cursor.json
LLM_BASE_URL=
LLM_ENDPOINT=responses
LLM_MODEL=gpt-5.4-mini
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MAX_INPUT_MESSAGES=20
LLM_MAX_OUTPUT_TOKENS=300
LLM_TEMPERATURE=0.4
LLM_PROMPT_NAME=brain_main
LLM_PROMPT_VERSION=v1
LLM_MOCK_DECISION_JSON={"decision":"reply","lead_status":"interested","reply_text":"Спасибо, передам детали менеджеру.","handoff_reason":null,"confidence":0.7}
BRAIN_MIN_INBOUND_BEFORE_HANDOFF=0
BRAIN_INBOUND_DEBOUNCE_SECONDS=10
BRAIN_CANCEL_OUTBOUND_ON_INBOUND=true
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
BRAIN_V2_ENABLED=false
BRAIN_SHADOW_MODE=true
BRAIN_ENABLE_VALIDATOR=true
LANGGRAPH_FUNNEL_ENABLED=true
LANGGRAPH_CHECKPOINT_POSTGRES_ENABLED=true
BRAIN_DEFAULT_PROVIDER=openai
BRAIN_INTEREST_CLASSIFIER_PROVIDER=
BRAIN_INTEREST_CLASSIFIER_MODEL=gpt-4.1-mini
BRAIN_ROUTER_PROVIDER=
BRAIN_ROUTER_MODEL=gpt-4.1-mini
BRAIN_DIALOGUE_PROVIDER=
BRAIN_DIALOGUE_MODEL=gpt-4.1
BRAIN_VALIDATOR_PROVIDER=
BRAIN_VALIDATOR_MODEL=gpt-4.1-mini
BRAIN_HANDOFF_SUMMARY_PROVIDER=
BRAIN_HANDOFF_SUMMARY_MODEL=gpt-4.1-mini
BRAIN_LLM_TEMPERATURE=0.2
BRAIN_LLM_TIMEOUT_SECONDS=30
BRAIN_LLM_MAX_RETRIES=2
OUTBOUND_REAL_SEND_ENABLED=false
OUTBOUND_ALLOWED_USERNAMES=@iamnekiy
# Анти-флуд пауза между исходящими с одного аккаунта. Маленькая, чтобы
# реплики внутри живого диалога и «пузыри» одного ответа не ждали минутами;
# реальная отправка + имитация печати дают естественную паузу сами по себе.
OUTBOUND_DEFAULT_SEND_INTERVAL_SECONDS=3
OUTBOUND_DEFAULT_SEND_JITTER_SECONDS=3
OUTBOUND_MARK_READ_ON_SEND=true
OUTBOUND_TYPING_DELAY_SECONDS=0
OUTBOUND_VOICE_RECORDING_DELAY_SECONDS=50

# --- Дайвинчик auto-swiper (python -m app.services.daivinchik) ---
DAIVINCHIK_ENABLED=false
DAIVINCHIK_BOT_USERNAME=@leomatchbot
DAIVINCHIK_TIMEZONE=Europe/Moscow
DAIVINCHIK_ACTIVE_HOURS_START=10
DAIVINCHIK_ACTIVE_HOURS_END=21
DAIVINCHIK_POLL_INTERVAL_SECONDS=5
DAIVINCHIK_MIN_ACTION_DELAY_SECONDS=30
DAIVINCHIK_MAX_ACTION_DELAY_SECONDS=60
DAIVINCHIK_LIKE_PROBABILITY=0.5
DAIVINCHIK_DAILY_LEAD_LIMIT=7
DAIVINCHIK_LIMIT_PAUSE_MINUTES=90
DAIVINCHIK_AD_BUTTON_FROM_RIGHT=2
DAIVINCHIK_HISTORY_LIMIT=12
DAIVINCHIK_STATE_PATH=daivinchik_state.json
DAIVINCHIK_REVIEW_LOG_PATH=daivinchik_review.jsonl
DAIVINCHIK_LEADS_PATH=daivinchik_leads.jsonl
DAIVINCHIK_LEAD_SOURCE=daivinchik

# --- Lead / handoff alerts (Telegram) ---
# Алерты лидов и хендоффа идут в supervisor-бот (CONTROL_BOT_TOKEN + CONTROL_ADMIN_CHAT_ID).
LEAD_ALERTS_ENABLED=true
# Опционально: выделенный бот/чат только для хендофф-уведомлений
# («лида пора устроить на работу»). Если пусто — фолбэк на supervisor-бот.
HANDOFF_BOT_TOKEN=
HANDOFF_CHAT_ID=
